#!/bin/sh
# Anticore macOS Post-Install Hook
# Monolith Works (c) 2026
# Automatically removes Gatekeeper quarantine attributes and sets executable permissions.

APP_PATH="/Applications/Anticore.app"
BINARY_PATH="${APP_PATH}/Contents/MacOS/Anticore"

if [ -d "$APP_PATH" ]; then
    xattr -cr "$APP_PATH" 2>/dev/null || true
    chmod -R 755 "$APP_PATH" 2>/dev/null || true
fi

# Kalici yetkilendirme (Sifir Sifre): Ag motoru (utun/pfctl) root gerektirir.
# Kullanicinin her acilista parola girmesini engellemek icin sudoers tanimi yapilir.
# ONEMLI: sudoers.d altindaki dosya adlarinda nokta (.) bulunursa sudo dosyayi yok sayar.
if [ -f "$BINARY_PATH" ]; then
    mkdir -p /etc/sudoers.d
    rm -f /etc/sudoers.d/com.monolithworks.anticore
    SUDOERS_FILE="/etc/sudoers.d/anticore"
    CLI_PATH="${APP_PATH}/Contents/MacOS/anticore-cli"
    echo "Defaults!${BINARY_PATH} env_keep += \"HOME USER LOGNAME DISPLAY XPC_FLAGS\"" > "$SUDOERS_FILE"
    echo "ALL ALL=(ALL) NOPASSWD: ${BINARY_PATH}, ${CLI_PATH}, /usr/sbin/installer" >> "$SUDOERS_FILE"
    chmod 440 "$SUDOERS_FILE"
    grep -q "sudoers.d" /etc/sudoers || echo "#includedir /private/etc/sudoers.d" >> /etc/sudoers
fi

exit 0