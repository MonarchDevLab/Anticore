{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anticore",
  "version": "0.3.1",
  "identifier": "com.anticore.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anticore",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "quick-panel",
        "title": "Anticore Quick Panel",
        "width": 340,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "copyright": "Copyright (c) 2026 Monolith Works. All rights reserved.",
    "publisher": "MonarchDevLab",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../vendor/windows/WinDivert.dll": "WinDivert.dll",
      "../../vendor/windows/WinDivert64.sys": "WinDivert64.sys",
      "../../vendor/windows/WebView2Loader.dll": "WebView2Loader.dll",
      "../../engine/target/release/anticore.exe": "anticore-cli.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1QTRFREEwMDFGNDFFNTMKUldSVEh2UUJvTzJrRmE3UGFDdG81YWtnYUdYSkhFdWQxVGJ0V2VVdHFKNDJvaGZRWS90TWx3ejMK",
      "endpoints": [
        "https://github.com/MonarchDevLab/Anticore/releases/latest/download/latest.json"
      ]
    }
  }
}
