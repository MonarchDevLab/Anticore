{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anticore",
  "version": "0.3.0",
  "identifier": "com.anticore.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anticore",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "copyright": "Copyright (c) 2026 Monolith Works. All rights reserved.",
    "publisher": "MonarchDevLab",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../../WinDivert.dll",
      "../../WinDivert64.sys",
      "../../WebView2Loader.dll",
      "../../engine/target/release/anticore.exe"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1QTRFREEwMDFGNDFFNTMKUldSVEh2UUJvTzJrRmE3UGFDdG81YWtnYUdYSkhFdWQxVGJ0V2VVdHFKNDJvaGZRWS90TWx3ejMK",
      "endpoints": [
        "https://github.com/MonarchDevLab/Anticore/releases/latest/download/latest.json"
      ]
    }
  }
}
